# Required secret. Set it as a Portainer stack environment variable.
# Cloudflare remotely-managed tunnel token: the long string after --token in the dashboard install command.
CLOUDFLARE_TUNNEL_TOKEN=

# Required secret. Basic auth users for the Traefik dashboard (traefik.nowstart.org), htpasswd bcrypt format.
# Generate on a manager: docker run --rm -it httpd:2.4-alpine htpasswd -nB admin
# Paste the output (admin:$2y$...) as-is; do not escape $ as $$.
TRAEFIK_DASHBOARD_USERS=
