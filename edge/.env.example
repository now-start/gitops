# Required secret. Set it as a Portainer stack environment variable.
# Cloudflare remotely-managed tunnel token: the long string after --token in the dashboard install command.
CLOUDFLARE_TUNNEL_TOKEN=

# Synology OIDC client secret. Callback: https://traefik.nowstart.org/oauth2/callback
TRAEFIK_SSO_CLIENT_SECRET=

# Required shared cookie encryption key for all oauth2-proxy replicas (32 random bytes, base64).
# Generate on a manager: openssl rand -base64 32
TRAEFIK_SSO_COOKIE_SECRET=
