# Required secrets. Set them as Portainer stack environment variables.
# PostgreSQL superuser (postgres) password.
POSTGRES_SUPERUSER_PASSWORD=
# Replication user (standby) password.
POSTGRES_STANDBY_PASSWORD=
# Spilo admin role (admin) password.
POSTGRES_ADMIN_PASSWORD=
# pgAdmin login. The email must use a real domain; pgAdmin rejects reserved TLDs such as .local.
PGADMIN_EMAIL=
PGADMIN_PASSWORD=
# Synology OIDC client. Callback: https://pgadmin.nowstart.org/oauth2/authorize
# Only the administrators group may sign in through SSO; internal login remains available.
PGADMIN_SSO_CLIENT_ID=
PGADMIN_SSO_CLIENT_SECRET=

# Optional. Swarm node hostnames for members a (A region), b (A region), c (B region).
# POSTGRES_NODE_A=NOW_START
# POSTGRES_NODE_B=Worker
# POSTGRES_NODE_C=Backup
# Optional. Host-mode pgAdmin port on the node that runs pgAdmin.
# PGADMIN_PORT=5050
