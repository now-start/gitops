# Copy these defaults into Arcane's .env editor. Never commit the real .env.
# Fill SPRING_ENCRYPT_KEY in Arcane before the first deploy.
TZ=Asia/Seoul
CONFIG_IMAGE=ghcr.io/now-start/config
CONFIG_TAG=latest
EUREKA_IMAGE=ghcr.io/now-start/eureka
EUREKA_TAG=latest
ADMIN_IMAGE=ghcr.io/now-start/admin
ADMIN_TAG=latest
GATEWAY_IMAGE=ghcr.io/now-start/gateway
GATEWAY_TAG=latest
GATEWAY_PORT=8000
GATEWAY_JAVA_TOOL_OPTIONS=-XX:MaxDirectMemorySize=256m
SPRING_CONFIG_IMPORT=configserver:http://config:8888
EUREKA_URL=http://eureka:8761/eureka/
SPRING_ENCRYPT_KEY=
