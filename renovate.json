{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["docker-compose", "github-actions", "custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track digest-pinned *_IMAGE env values in workflows",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "_IMAGE:\\s*[\"']?(?<depName>[^\\s:@\"']+):(?<currentValue>[^\\s@\"']+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "ignorePaths": ["_template/**"],
  "pinDigests": false,
  "timezone": "Asia/Seoul",
  "prHourlyLimit": 0,
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": false,
  "packageRules": [
    {
      "matchManagers": ["docker-compose", "github-actions", "custom.regex"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["renovate/renovate"],
      "schedule": ["* 0-5 * * *"],
      "updateNotScheduled": false
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/zalando/spilo-18"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)-p(?<patch>\\d+)$"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/zalando/spilo-18", "quay.io/coreos/etcd"],
      "automerge": false
    }
  ]
}
