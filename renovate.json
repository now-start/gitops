{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["docker-compose", "github-actions"],
  "ignorePaths": ["_template/**"],
  "pinDigests": false,
  "timezone": "Asia/Seoul",
  "prHourlyLimit": 0,
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": false,
  "packageRules": [
    {
      "matchManagers": ["docker-compose", "github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["renovate/renovate"],
      "schedule": ["* 0-5 * * *"],
      "updateNotScheduled": false
    },
    {
      "description": "Pause barosteel automerge during approval-policy deployment",
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchFileNames": ["barosteel/docker-compose.yml"],
      "matchPackageNames": ["ghcr.io/now-start/barosteel"],
      "automerge": false
    }
  ]
}
