# Copy these defaults into Arcane's .env editor. Never commit the real .env.
TZ=Asia/Seoul
BITWARDEN_IMAGE=vaultwarden/server
BITWARDEN_TAG=latest
BITWARDEN_PORT=1080
BITWARDEN_REPLICAS=1
BITWARDEN_DOMAIN=https://bitwarden.nowstart.org
BITWARDEN_SSO_AUTHORITY=https://sso.nowstart.org/webman/sso
BITWARDEN_SSO_CLIENT_ID=
BITWARDEN_SSO_CLIENT_SECRET=
NFS_ADDRESS=10.8.0.1
BITWARDEN_NFS_PATH=/volume1/docker/bitwarden
