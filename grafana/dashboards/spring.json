{
  "uid": "nowstart-spring",
  "title": "Spring Boot 상세 · JVM / DB / 외부 호출",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "now-start",
    "operations"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "서비스",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(jvm_memory_used_bytes, service_name)",
          "refId": "service"
        },
        "definition": "label_values(jvm_memory_used_bytes, service_name)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "instance",
        "label": "인스턴스",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(jvm_memory_used_bytes{service_name=~\"$service\"}, instance)",
          "refId": "instance"
        },
        "definition": "label_values(jvm_memory_used_bytes{service_name=~\"$service\"}, instance)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "읽는 방법",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "서비스와 인스턴스를 선택하세요. JVM 메모리는 컨테이너 전체 메모리가 아닙니다. DB·Circuit Breaker가 없는 앱은 해당 패널이 비어 있는 것이 정상입니다. [로그](/a/grafana-lokiexplore-app/explore) · [트레이스](/a/grafana-exploretraces-app/)"
      }
    },
    {
      "title": "Heap 사용량 / 확보량",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service_name,instance) (jvm_memory_used_bytes{service_name=~\"$service\",instance=~\"$instance\",area=\"heap\"})",
          "legendFormat": "{{service_name}} {{instance}} used",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "sum by(service_name,instance) (jvm_memory_committed_bytes{service_name=~\"$service\",instance=~\"$instance\",area=\"heap\"})",
          "legendFormat": "{{service_name}} {{instance}} committed",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Heap 사용률",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by(service_name,instance) (jvm_memory_used_bytes{service_name=~\"$service\",instance=~\"$instance\",area=\"heap\"}) / sum by(service_name,instance) (jvm_memory_max_bytes{service_name=~\"$service\",instance=~\"$instance\",area=\"heap\"} > 0)",
          "legendFormat": "{{service_name}} / {{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 9
      }
    },
