        "uid": "prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(routeId) (rate(spring_cloud_gateway_requests_seconds_count{httpStatusCode=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "{{routeId}}",
          "range": true,
