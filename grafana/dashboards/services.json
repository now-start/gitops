      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,routeId) (rate(spring_cloud_gateway_requests_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{routeId}}",
          "range": true,
