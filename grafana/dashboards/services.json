{
  "uid": "nowstart-services",
  "title": "서비스 현황 · Spring Boot",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "now-start",
    "operations"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "서비스",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(jvm_memory_used_bytes, service_name)",
          "refId": "service"
        },
        "definition": "label_values(jvm_memory_used_bytes, service_name)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "instance",
        "label": "인스턴스",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(jvm_memory_used_bytes{service_name=~\"$service\"}, instance)",
          "refId": "instance"
        },
        "definition": "label_values(jvm_memory_used_bytes{service_name=~\"$service\"}, instance)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "읽는 방법",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "사용자 영향은 요청량 → 5xx → p95/p99 순서로 확인하세요. 평균은 문제 인스턴스를 가릴 수 있습니다. [로그 탐색](/a/grafana-lokiexplore-app/explore) · [트레이스 탐색](/a/grafana-exploretraces-app/)에서 같은 서비스와 시간 범위를 선택하세요. No data는 정상/0을 의미하지 않습니다."
      }
    },
    {
      "title": "요청량 · 서비스별",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Actuator 경로 제외. Gateway 프록시 요청은 아래 Route 패널에서 별도로 확인합니다.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service_name) (rate(http_server_requests_seconds_count{service_name=~\"$service\",instance=~\"$instance\",uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "HTTP 5xx 비율",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "100 * ((sum by(service_name) (rate(http_server_requests_seconds_count{service_name=~\"$service\",instance=~\"$instance\",uri!~\"/actuator.*\",status=~\"5..\"}[$__rate_interval]))) or (0 * (sum by(service_name) (rate(http_server_requests_seconds_count{service_name=~\"$service\",instance=~\"$instance\",uri!~\"/actuator.*\"}[$__rate_interval]))))) / clamp_min((sum by(service_name) (rate(http_server_requests_seconds_count{service_name=~\"$service\",instance=~\"$instance\",uri!~\"/actuator.*\"}[$__rate_interval]))), 0.000001)",
          "legendFormat": "{{service_name}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "응답 시간 p95 / p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le,service_name) (rate(http_server_requests_seconds_bucket{service_name=~\"$service\",instance=~\"$instance\",uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "{{service_name}} p95",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by(le,service_name) (rate(http_server_requests_seconds_bucket{service_name=~\"$service\",instance=~\"$instance\",uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "{{service_name}} p99",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "메트릭 수신 인스턴스 수",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "최근 3분 내 수신한 JVM 인스턴스 수. readiness와 동일하지 않습니다.",
      "targets": [
        {
          "refId": "A",
          "expr": "count by(service_name) (max by(service_name,instance) (timestamp(jvm_memory_used_bytes{service_name=~\"$service\",instance=~\"$instance\"}) > time()-180))",
          "legendFormat": "{{service_name}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "서비스 버전 · 인스턴스",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "버전 변경과 인스턴스 교체를 확인합니다.",
      "targets": [
        {
          "refId": "A",
          "expr": "count by(service_name,service_version,instance,host_name) (jvm_memory_used_bytes{service_name=~\"$service\",instance=~\"$instance\"})",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "오류 로그 발생률",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service_name) (rate(logback_events_total{service_name=~\"$service\",instance=~\"$instance\",level=\"error\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "느린 API p95 · 상위 10",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10,histogram_quantile(0.95,sum by(le,service_name,uri) (rate(http_server_requests_seconds_bucket{service_name=~\"$service\",instance=~\"$instance\",uri!~\"/actuator.*\"}[$__rate_interval]))))",
          "legendFormat": "{{service_name}} {{uri}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9,
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Gateway Route 요청량",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Gateway 전체 프록시 트래픽. 상단 서비스 필터와 독립적입니다.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(routeId) (rate(spring_cloud_gateway_requests_seconds_count[$__rate_interval]))",
          "legendFormat": "{{routeId}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
