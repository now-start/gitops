{
  "uid": "nowstart-swarm",
  "title": "Swarm 인프라 · 현재 수집 범위",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "now-start",
    "operations"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "서비스",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(process_uptime_seconds, service_name)",
          "refId": "service"
        },
        "definition": "label_values(process_uptime_seconds, service_name)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "읽는 방법",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**기존 메트릭만 사용합니다.** 컨테이너 전체 메모리/상한, 노드별 자원, Swarm 목표 replica, OOM 지표는 현재 미수집이므로 표시하지 않습니다. 시스템 메모리는 evergreen만 제공합니다. No data는 0 또는 정상 상태를 뜻하지 않습니다. 상단 서비스 필터는 앱 지표에만 적용됩니다."
      }
    },
    {
      "title": "시스템 메모리 사용률 · 수집 앱 기준",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "현재 evergreen에서만 수집. 모든 Swarm 노드의 사용률이 아닙니다.",
      "targets": [
        {
          "refId": "A",
          "expr": "100 * system_memory_utilization_ratio{state=\"used\"}",
          "legendFormat": "{{service_name}} {{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "시스템 메모리 사용량",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "system_memory_usage_bytes{state=\"used\"}",
          "legendFormat": "{{service_name}} {{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "시스템 CPU 사용률 · 앱 관측",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "각 JVM이 관측한 시스템 CPU 비율입니다. 같은 노드의 여러 앱을 합산하지 마세요.",
      "targets": [
        {
          "refId": "A",
          "expr": "100 * system_cpu_usage{service_name=~\"$service\"}",
          "legendFormat": "{{service_name}} {{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "프로세스 CPU 사용률",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "100 * process_cpu_usage{service_name=~\"$service\"}",
          "legendFormat": "{{service_name}} {{instance}}",
          "range": true,
