    {
      "title": "애플리케이션 디스크 여유",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "앱의 작업 디렉터리 기준 파일시스템. 전체 노드 디스크 목록이 아닙니다.",
      "targets": [
        {
          "refId": "A",
          "expr": "disk_free_bytes{service_name=~\"$service\"}",
          "legendFormat": "{{service_name}} {{instance}} {{path}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
