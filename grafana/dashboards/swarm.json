          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "애플리케이션 디스크 사용률",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - disk_free_bytes{service_name=~\"$service\"} / disk_total_bytes{service_name=~\"$service\"})",
