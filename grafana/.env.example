# Copy these defaults into Arcane's .env editor. Never commit the real .env.
# Fill required OAuth and SMTP values in Arcane before the first deploy.
TZ=Asia/Seoul
GRAFANA_IMAGE=grafana/otel-lgtm
GRAFANA_TAG=latest
GRAFANA_PORT=3000
GRAFANA_REPLICAS=1
GRAFANA_ROOT_URL=https://grafana.nowstart.org
GRAFANA_OAUTH_CLIENT_ID=
GRAFANA_OAUTH_CLIENT_SECRET=
GRAFANA_OAUTH_AUTH_URL=https://sso.nowstart.org/webman/sso/SSOOauth.cgi
GRAFANA_OAUTH_TOKEN_URL=https://sso.nowstart.org/webman/sso/SSOAccessToken.cgi
GRAFANA_OAUTH_API_URL=https://sso.nowstart.org/webman/sso/SSOUserInfo.cgi
GRAFANA_SMTP_HOST=mail.nowstart.org:587
GRAFANA_SMTP_USER=
GRAFANA_SMTP_PASSWORD=
GRAFANA_SMTP_FROM_ADDRESS=no-reply@nowstart.org
NFS_ADDRESS=10.8.0.1
GRAFANA_NFS_PATH=/volume1/docker/grafana
