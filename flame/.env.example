# Copy these defaults into Arcane's .env editor. Never commit the real .env.
# Fill FLAME_PASSWORD in Arcane before the first deploy.
TZ=Asia/Seoul
FLAME_IMAGE=pawelmalak/flame
FLAME_TAG=latest
FLAME_PORT=5005
FLAME_REPLICAS=1
FLAME_PASSWORD=
NFS_ADDRESS=10.8.0.1
FLAME_NFS_PATH=/volume1/docker/flame
