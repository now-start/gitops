# No secret is required because this CockroachDB stack uses insecure mode.
# COCKROACHDB_SQL_PORT=26257
# COCKROACHDB_HTTP_PORT=8080
# Automatic decommissioning is enabled by default.
# COCKROACHDB_AUTO_DECOMMISSION=true
# COCKROACHDB_DECOMMISSION_INTERVAL=300
# COCKROACHDB_DECOMMISSION_GRACE_CHECKS=12
# COCKROACHDB_DECOMMISSION_MIN_LIVE_NODES=3
